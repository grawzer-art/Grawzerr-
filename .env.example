# ─────────────────────────────────────────────────────────────
# JARVIS — variables d'environnement
# Copie ce fichier dans les "Environment Variables" de Vercel.
# NE JAMAIS committer de vraies valeurs dans le dépôt (il est public).
# ─────────────────────────────────────────────────────────────

# ── Supabase (mémoire + authentification) ────────────────────
# Supabase > Project Settings > API (ou "API Keys")
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Clé "publishable" (sb_publishable_...) ou ancienne clé "anon". Elle est publique
# par conception : la sécurité repose sur les règles RLS du fichier SQL.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# Liste blanche : seules ces adresses peuvent utiliser JARVIS (séparées par des virgules).
JARVIS_ALLOWED_EMAILS=toi@example.com

# ── Fournisseur IA (côté serveur uniquement) ─────────────────
# Valeurs possibles : gemini | groq | mistral | openrouter | openai | anthropic
JARVIS_AI_PROVIDER=gemini
# Modèle (optionnel : chaque fournisseur a une valeur par défaut)
# JARVIS_AI_MODEL=gemini-flash-latest

# Une seule clé est nécessaire : celle du fournisseur choisi.
GEMINI_API_KEY=
# GROQ_API_KEY=
# MISTRAL_API_KEY=
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Effort de réflexion pour Claude (low | medium | high). Ignoré par les autres fournisseurs.
# JARVIS_ANTHROPIC_EFFORT=low

# ── Garde-fous de consommation ───────────────────────────────
# Les fournisseurs payants (anthropic, openai, et mistral/openrouter hors modèles gratuits)
# sont BLOQUÉS tant que JARVIS_MONTHLY_BUDGET_USD vaut 0.
JARVIS_MONTHLY_BUDGET_USD=0
JARVIS_DAILY_REQUEST_LIMIT=200
JARVIS_DAILY_TOKEN_LIMIT=400000
JARVIS_PER_MINUTE_LIMIT=12
# Déclarer un fournisseur comme gratuit (ex. compte Gemini sans facturation) : true | false
# JARVIS_PROVIDER_IS_FREE=true
